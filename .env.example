NODE_ENV=development
PORT=3000

# PostgreSQL container initialization (used by Docker Compose)
POSTGRES_USER=tickethub
POSTGRES_PASSWORD=tickethub_dev_password
POSTGRES_DB=tickethub
POSTGRES_PORT=5432

# Required by NestJS API & TypeORM CLI (override with managed DB URL in production)
DATABASE_URL=postgresql://tickethub:tickethub_dev_password@localhost:5432/tickethub
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10

# Swagger UI at /docs
SWAGGER_ENABLED=true
